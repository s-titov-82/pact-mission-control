<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Pact.App.Avalonia.App"
             RequestedThemeVariant="Default">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="TextBlock.SettingsFieldLabel">
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Margin" Value="0,6,10,4" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}" />
    </Style>
    <Style Selector="TextBlock.SettingsInfoLine">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style Selector="TextBox.SettingsMultiline">
      <Setter Property="AcceptsReturn" Value="True" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
      <Setter Property="MinHeight" Value="80" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    </Style>
    <Style Selector="Button.compact-icon, ToggleButton.compact-icon">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.scenario-command, ToggleButton.scenario-command">
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.scenario-command.compact-icon">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="0" />
    </Style>
  </Application.Styles>
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="AppBorderBrush" Color="#CBD5E1" />
          <SolidColorBrush x:Key="AppPanelBorderBrush" Color="#334155" />
          <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="AppPaneBackgroundBrush" Color="#F8FAFC" />
          <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="#111827" />
          <SolidColorBrush x:Key="AppTextMutedBrush" Color="#64748B" />
          <SolidColorBrush x:Key="AppTextFaintBrush" Color="#6B7280" />
          <SolidColorBrush x:Key="AppAccentBrush" Color="#2563EB" />
          <SolidColorBrush x:Key="AppAccentSoftBrush" Color="#DBEAFE" />
          <SolidColorBrush x:Key="AppDangerBrush" Color="#DC2626" />
          <SolidColorBrush x:Key="AppDangerStrongBrush" Color="#B91C1C" />
          <SolidColorBrush x:Key="AppWarningBackgroundBrush" Color="#FEF3C7" />
          <SolidColorBrush x:Key="AppWarningBorderBrush" Color="#D97706" />
          <SolidColorBrush x:Key="AppScenarioLockBrush" Color="#7C3AED" />
          <SolidColorBrush x:Key="AppSuccessBrush" Color="#16A34A" />
          <SolidColorBrush x:Key="AppStepBackgroundBrush" Color="#E5E7EB" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="AppBorderBrush" Color="#334155" />
          <SolidColorBrush x:Key="AppPanelBorderBrush" Color="#475569" />
          <SolidColorBrush x:Key="AppSurfaceBrush" Color="#111827" />
          <SolidColorBrush x:Key="AppPaneBackgroundBrush" Color="#0F172A" />
          <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="#F8FAFC" />
          <SolidColorBrush x:Key="AppTextMutedBrush" Color="#94A3B8" />
          <SolidColorBrush x:Key="AppTextFaintBrush" Color="#9CA3AF" />
          <SolidColorBrush x:Key="AppAccentBrush" Color="#60A5FA" />
          <SolidColorBrush x:Key="AppAccentSoftBrush" Color="#1E3A5F" />
          <SolidColorBrush x:Key="AppDangerBrush" Color="#F87171" />
          <SolidColorBrush x:Key="AppDangerStrongBrush" Color="#FCA5A5" />
          <SolidColorBrush x:Key="AppWarningBackgroundBrush" Color="#3A2A14" />
          <SolidColorBrush x:Key="AppWarningBorderBrush" Color="#B97818" />
          <SolidColorBrush x:Key="AppScenarioLockBrush" Color="#A78BFA" />
          <SolidColorBrush x:Key="AppSuccessBrush" Color="#4ADE80" />
          <SolidColorBrush x:Key="AppStepBackgroundBrush" Color="#1F2937" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <SolidColorBrush x:Key="AppTerminalBackgroundBrush" Color="#09090B" />
      <SolidColorBrush x:Key="AppDimOverlayBrush" Color="#99000000" />
