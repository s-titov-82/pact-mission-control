<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="https://github.com/whistyun/Markdown.Avalonia"
             xmlns:editing="clr-namespace:Pact.App.Avalonia.Views.Editing"
             xmlns:remarks="clr-namespace:Pact.App.Avalonia.Views.Remarks"
             x:Class="Pact.App.Avalonia.Views.ProjectScreenView"
             x:CompileBindings="False">
  <Grid RowDefinitions="Auto,*" Background="{DynamicResource AppPaneBackgroundBrush}">
    <Border Padding="10,8" BorderBrush="{StaticResource AppPanelBorderBrush}" BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <ToggleButton x:Name="OverviewTab" Height="32" Content="Overview" Click="OnOverviewTabClicked" />
        <ToggleButton x:Name="ChangesTab" Height="32" Click="OnChangesTabClicked"
                      Content="{Binding Changes.TabHeader}" IsVisible="{Binding HasChanges}" />
        <ToggleButton x:Name="ReviewLogsTab" Height="32" Content="Review logs" Click="OnReviewLogsTabClicked" />
      </StackPanel>
    </Border>

    <StackPanel x:Name="OverviewPanel" Grid.Row="1" Margin="20,18" Spacing="6">
      <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding Name}" />
      <SelectableTextBlock Foreground="{DynamicResource AppTextMutedBrush}" Text="{Binding RootPath}" />
      <TextBlock Text="{Binding Branch}" IsVisible="{Binding HasChanges}" />
    </StackPanel>

    <Grid x:Name="ChangesPanel" Grid.Row="1" IsVisible="False">
      <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel>
          <!-- How the file is shown; the model keeps the choice across files and falls back where a file does not allow it. -->
          <StackPanel x:Name="ModeBar" Orientation="Horizontal" Spacing="4" Margin="10,6">
            <ToggleButton x:Name="DiffModeButton" Height="26" Padding="10,2" Content="Diff" Click="OnDiffModeClicked" />
            <ToggleButton x:Name="WholeFileModeButton" Height="26" Padding="10,2" Content="Whole file" Click="OnWholeFileModeClicked" />
            <ToggleButton x:Name="RenderedModeButton" Height="26" Padding="10,2" Content="Rendered" Click="OnRenderedModeClicked" />
          </StackPanel>
          <TextBlock x:Name="DiffPlaceholderText" Margin="12" Opacity="0.7"
                     Text="{Binding Changes.DiffPlaceholder}" IsVisible="False" />
        </StackPanel>
        <editing:SourceEditor x:Name="DiffEditor" Grid.Row="1" IsReadOnly="True"
                       FontFamily="Cascadia Mono, Consolas, monospace" FontSize="14"
                       HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
        <!-- The rendered view of a Markdown file takes the diff's place. -->
        <Panel x:Name="RenderedHost" Grid.Row="1" IsVisible="False" />
        <!-- Lies over the diff without taking its clicks; only the overlay inside is hit-testable. -->
        <Canvas x:Name="RemarkLayer" Grid.Row="1" ClipToBounds="True">
          <remarks:RemarkOverlay x:Name="RemarkOverlay" IsVisible="False" />
        </Canvas>
        <Button x:Name="ShowAllButton" Grid.Row="2" Margin="12,6" HorizontalAlignment="Left"
                Content="{Binding Changes.ShowAllText}" IsVisible="False" Click="OnShowAllClicked" />
      </Grid>
    </Grid>

    <Grid x:Name="ReviewLogsPanel" Grid.Row="1" IsVisible="False">
      <md:MarkdownScrollViewer x:Name="ReviewLogPreview" Margin="10" IsVisible="{Binding HasReviewLogs}"
                               SelectionEnabled="True" Markdown="{Binding ReviewLogText}" />
      <TextBlock x:Name="NoReviewLogsText" Margin="12" Opacity="0.7" IsVisible="{Binding !HasReviewLogs}"
                 Text="No review logs yet. Logs of reviews run in this project appear here." />
    </Grid>
  </Grid>
</UserControl>
