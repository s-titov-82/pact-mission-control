<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="https://github.com/whistyun/Markdown.Avalonia"
             xmlns:editing="clr-namespace:Pact.App.Avalonia.Views.Editing"
             x:Class="Pact.App.Avalonia.Views.ProjectScreenView"
             x:CompileBindings="False">
  <Grid RowDefinitions="Auto,*" Background="{DynamicResource AppPaneBackgroundBrush}">
    <Border Padding="10,8" BorderBrush="{StaticResource AppPanelBorderBrush}" BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <ToggleButton x:Name="OverviewTab" Height="32" Content="Overview" Click="OnOverviewTabClicked" />
        <ToggleButton x:Name="ChangesTab" Height="32" Click="OnChangesTabClicked"
                      Content="{Binding Changes.TabHeader}" IsVisible="{Binding HasChanges}" />
        <ToggleButton x:Name="ReviewLogsTab" Height="32" Content="Review logs" Click="OnReviewLogsTabClicked" />
      </StackPanel>
    </Border>

    <StackPanel x:Name="OverviewPanel" Grid.Row="1" Margin="20,18" Spacing="6">
      <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding Name}" />
      <SelectableTextBlock Foreground="{DynamicResource AppTextMutedBrush}" Text="{Binding RootPath}" />
      <TextBlock Text="{Binding Branch}" IsVisible="{Binding HasChanges}" />
    </StackPanel>

    <Grid x:Name="ChangesPanel" Grid.Row="1" IsVisible="False">
      <Grid RowDefinitions="Auto,*,Auto">
        <TextBlock x:Name="DiffPlaceholderText" Margin="12" Opacity="0.7"
                   Text="{Binding Changes.DiffPlaceholder}" IsVisible="False" />
        <editing:SourceEditor x:Name="DiffEditor" Grid.Row="1" IsReadOnly="True"
                       FontFamily="Cascadia Mono, Consolas, monospace" FontSize="14"
                       HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
        <Button x:Name="ShowAllButton" Grid.Row="2" Margin="12,6" HorizontalAlignment="Left"
                Content="{Binding Changes.ShowAllText}" IsVisible="False" Click="OnShowAllClicked" />
      </Grid>
    </Grid>

    <Grid x:Name="ReviewLogsPanel" Grid.Row="1" IsVisible="False">
      <md:MarkdownScrollViewer x:Name="ReviewLogPreview" Margin="10"
                               SelectionEnabled="True" Markdown="{Binding ReviewLogText}" />
    </Grid>
  </Grid>
</UserControl>
