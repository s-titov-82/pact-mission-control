<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:remarks="clr-namespace:Pact.App.Avalonia.Views.Remarks"
             x:Class="Pact.App.Avalonia.Views.Remarks.RemarkOverlay"
             x:CompileBindings="False">
  <Border Padding="10" CornerRadius="6" BorderThickness="1"
          Background="{DynamicResource AppPopupBackgroundBrush}"
          BorderBrush="{StaticResource AppPanelBorderBrush}"
          BoxShadow="0 4 14 0 #40000000">
    <Grid RowDefinitions="*">
      <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,24,0">
        <StackPanel Spacing="10">
          <ItemsControl x:Name="ThreadsList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <remarks:RemarkThreadView />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel x:Name="NewRemarkPanel" Spacing="6">
            <TextBox x:Name="NewRemarkBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48" MaxHeight="160"
                     Watermark="Remark on this line…" />
            <Button x:Name="AddRemarkButton" Content="Add" Click="OnAddClicked" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
      <Button x:Name="CloseButton" Classes="compact-icon" HorizontalAlignment="Right" VerticalAlignment="Top"
              Content="✕" ToolTip.Tip="Close" Click="OnCloseClicked" />
    </Grid>
  </Border>
</UserControl>
