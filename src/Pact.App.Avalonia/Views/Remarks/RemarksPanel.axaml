<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:remarks="clr-namespace:Pact.App.Avalonia.Views.Remarks"
             x:Class="Pact.App.Avalonia.Views.Remarks.RemarksPanel"
             x:CompileBindings="False">
  <UserControl.Styles>
    <!-- The lists size themselves to the room they have; the theme's small presenter would make them scroll. -->
    <Style Selector="FlyoutPresenter.remark-list">
      <Setter Property="MaxWidth" Value="100000" />
      <Setter Property="MaxHeight" Value="100000" />
      <Setter Property="Background" Value="{DynamicResource AppPopupBackgroundBrush}" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
      <!-- Only the list scrolls; the presenter's own scroller would scroll it as a whole, a scroller in a scroller. -->
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
    </Style>
    <Style Selector="Grid#RemarkButtons > Button">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="6,4" />
    </Style>
  </UserControl.Styles>
  <StackPanel Spacing="6">
    <TextBlock x:Name="RemarkBarText" FontWeight="SemiBold" IsVisible="False" />
    <TextBlock x:Name="RemarkStatusText" IsVisible="False" TextWrapping="Wrap"
               Foreground="{DynamicResource AppTextMutedBrush}" />
    <!-- The buttons stay put; an empty list only disables its button. -->
    <Grid x:Name="RemarkButtons" ColumnDefinitions="*,6,*,6,*">
      <Button x:Name="ResolvedRemarksButton" ToolTip.Tip="Remarks already resolved">
        <Button.Flyout>
          <Flyout Placement="LeftEdgeAlignedBottom" FlyoutPresenterClasses="remark-list">
            <ScrollViewer x:Name="ResolvedRemarksScroller" Width="600" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl x:Name="ResolvedRemarksList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <remarks:RemarkThreadView Margin="0,0,0,12" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Flyout>
        </Button.Flyout>
      </Button>
      <Button x:Name="OpenRemarksButton" Grid.Column="2" ToolTip.Tip="Remarks not resolved yet">
        <Button.Flyout>
          <Flyout Placement="LeftEdgeAlignedBottom" FlyoutPresenterClasses="remark-list">
            <ScrollViewer x:Name="OpenRemarksScroller" Width="600" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl x:Name="OpenRemarksList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <remarks:RemarkThreadView Margin="0,0,0,12" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Flyout>
        </Button.Flyout>
      </Button>
      <Button x:Name="SendRemarksButton" Grid.Column="4" Content="Send" Click="OnSendRemarksClicked" />
    </Grid>
  </StackPanel>
</UserControl>
