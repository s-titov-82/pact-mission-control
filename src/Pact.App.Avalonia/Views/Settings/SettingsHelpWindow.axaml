<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Pact.App.Avalonia.Views.Settings.SettingsHelpWindow"
        Icon="/Assets/AppIcon.ico"
        Title="Help"
        Height="480"
        Width="560"
        Background="{DynamicResource AppPaneBackgroundBrush}"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="16" RowDefinitions="Auto,*,Auto">
    <TextBlock x:Name="HelpTitleText" FontSize="16" FontWeight="SemiBold"
               Foreground="{DynamicResource AppTextPrimaryBrush}"
               TextWrapping="Wrap" />
    <TextBox x:Name="HelpBodyTextBox" Grid.Row="1" Margin="0,10,0,0"
             IsReadOnly="True" BorderThickness="0" Background="Transparent"
             TextWrapping="Wrap" AcceptsReturn="True"
             ScrollViewer.VerticalScrollBarVisibility="Auto" />
    <Button Grid.Row="2" HorizontalAlignment="Right" Margin="0,12,0,0"
            Width="80" Padding="10,5" Content="Close" Click="OnCloseClicked"
            HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
  </Grid>
</Window>
