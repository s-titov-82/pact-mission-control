<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Pact.Presentation.ViewModels;assembly=Pact.Presentation"
             xmlns:local="clr-namespace:Pact.App.Avalonia.Views"
             x:Class="Pact.App.Avalonia.Views.RightActionsPanel"
             x:CompileBindings="False">
  <Grid Margin="20,18" RowDefinitions="Auto,*">
    <DockPanel>
      <Button x:Name="SettingsButton" DockPanel.Dock="Right" Width="34" Height="30" Padding="0"
              HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
              ToolTip.Tip="Settings" Click="OnSettingsClicked"><PathIcon Width="16" Height="16" Data="{StaticResource AppSettingsIcon}" /></Button>
      <Button x:Name="RestartAndUpdateButton" DockPanel.Dock="Right" Height="30"
              Margin="0,0,8,0" Padding="8,0" IsVisible="False"
              HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
              Click="OnRestartAndUpdateClicked" />
      <Panel />
    </DockPanel>
    <Grid x:Name="DefaultActionsPanel" Grid.Row="1" RowDefinitions="Auto,0,Auto,Auto,*,Auto,Auto">
      <Grid x:Name="DocumentsSection" Grid.Row="1" Margin="0,20,0,0"
            RowDefinitions="Auto,*" IsVisible="False">
        <TextBlock FontWeight="SemiBold" Text="Documents" />
        <TreeView x:Name="DocumentTree" Grid.Row="1" Margin="0,8,0,0"
                  SelectionChanged="OnDocumentTreeSelectionChanged">
          <TreeView.Styles>
            <Style Selector="TreeViewItem">
              <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            </Style>
          </TreeView.Styles>
          <TreeView.ItemTemplate>
            <TreeDataTemplate x:DataType="vm:MarkdownTreeNodeViewModel" ItemsSource="{Binding Children}">
              <StackPanel Orientation="Horizontal" Spacing="6" Background="Transparent"
                          Tapped="OnDocumentRowTapped">
                <PathIcon Width="12" Height="12" VerticalAlignment="Center"
                          Data="{StaticResource AppFolderIcon}"
                          IsVisible="{Binding IsFolder}" />
                <TextBlock Text="{Binding Title}" ToolTip.Tip="{Binding RelativePath}"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </TreeDataTemplate>
          </TreeView.ItemTemplate>
        </TreeView>
      </Grid>
      <Grid x:Name="ProjectListSection" Grid.Row="1" Margin="0,20,0,0"
            RowDefinitions="Auto,*" IsVisible="False">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock x:Name="ProjectListTitle" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Button x:Name="DeleteAllReviewLogsButton" Height="24" Padding="8,0"
                  VerticalContentAlignment="Center" IsVisible="False"
                  ToolTip.Tip="Delete all review logs" Click="OnDeleteAllReviewLogsClicked">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <PathIcon Width="12" Height="12" Data="{StaticResource AppDeleteIcon}" />
              <TextBlock FontSize="12" VerticalAlignment="Center" Text="Delete all" />
            </StackPanel>
          </Button>
        </StackPanel>
        <ListBox x:Name="ChangedFilesList" Grid.Row="1" Margin="0,8,0,0"
                 SelectionChanged="OnChangedFileSelectionChanged">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="16,*,Auto" ToolTip.Tip="{Binding Path}">
                <TextBlock FontFamily="Cascadia Mono, Consolas, monospace" FontWeight="SemiBold"
                           Text="{Binding StatusLetter}" />
                <StackPanel Grid.Column="1">
                  <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11"
                             Text="{Binding Folder}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="6,0,0,0" VerticalAlignment="Center">
                  <TextBlock FontSize="10" HorizontalAlignment="Right"
                             Foreground="{DynamicResource AppTextMutedBrush}" Text="staged"
                             IsVisible="{Binding IsStaged}" />
                  <TextBlock FontSize="10" HorizontalAlignment="Right" Text="{Binding RemarksText}"
                             IsVisible="{Binding RemarksText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <ListBox x:Name="ReviewLogList" Grid.Row="1" Margin="0,8,0,0"
                 SelectionChanged="OnReviewLogSelectionChanged">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Text="{Binding Converter={x:Static local:RightActionsPanel.FileNameOnly}}" />
                <Button Grid.Column="1" Classes="compact-icon" Margin="6,0,0,0"
                        ToolTip.Tip="Delete review log" Click="OnDeleteReviewLogClicked">
                  <PathIcon Width="12" Height="12" Data="{StaticResource AppDeleteIcon}" />
                </Button>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
      <StackPanel Grid.Row="2">
        <TextBlock Margin="0,20,0,0" FontWeight="SemiBold" Text="Quick actions" />
        <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
          <ItemsControl x:Name="QuickActionsList" Margin="0,8,0,0" ItemsSource="{Binding VisibleQuickActions}">
            <ItemsControl.ItemTemplate><DataTemplate>
              <Button Height="32" Margin="0,0,0,6" Padding="10,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                      Content="{Binding Name}" Click="OnQuickActionClicked" />
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </StackPanel>
      <StackPanel x:Name="ChangesSection" Grid.Row="3" IsVisible="False">
        <Separator Margin="0,14,0,10" />
        <Button x:Name="ChangesEntry" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                Padding="10,6" Click="OnChangesEntryClicked">
          <StackPanel Spacing="2">
            <TextBlock x:Name="ChangesEntryTitle" FontWeight="SemiBold" />
            <TextBlock x:Name="ChangesEntrySubtitle" FontSize="11"
                       Foreground="{DynamicResource AppTextMutedBrush}" />
            <TextBlock x:Name="ChangesEntryRemarks" FontSize="11" IsVisible="False"
                       Foreground="{DynamicResource AppTextMutedBrush}" />
          </StackPanel>
        </Button>
        <TextBlock x:Name="NoChangesText" Foreground="{DynamicResource AppTextMutedBrush}"
                   Text="No uncommitted changes" IsVisible="False" />
      </StackPanel>
      <Grid x:Name="SelectedTabDetailsSection" Grid.Row="5" Margin="0,24,0,0" MaxHeight="360"
            RowDefinitions="Auto,Auto,*" IsVisible="False">
        <SelectableTextBlock FontWeight="SemiBold" Text="{Binding Heading}" />
        <SelectableTextBlock Grid.Row="1" Margin="0,4,0,0"
                             Foreground="{DynamicResource AppTextMutedBrush}" Text="{Binding Title}"
                             TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
        <ScrollViewer x:Name="SelectedTabDetailsScroller" Grid.Row="2" Margin="0,8,0,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <ItemsControl x:Name="SelectedTabDetailsRows" ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="92,*" Margin="0,0,0,5">
                  <SelectableTextBlock FontSize="11" Foreground="{DynamicResource AppTextFaintBrush}"
                                       Text="{Binding Label}" />
                  <SelectableTextBlock Grid.Column="1" FontSize="11" TextWrapping="Wrap"
                                       Text="{Binding Value}" ToolTip.Tip="{Binding ToolTip}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
      <TextBlock x:Name="StatusText" Grid.Row="6" Margin="0,16,0,0" IsVisible="False"
                 Foreground="{DynamicResource AppTextFaintBrush}" TextWrapping="Wrap" />
    </Grid>
  </Grid>
</UserControl>
