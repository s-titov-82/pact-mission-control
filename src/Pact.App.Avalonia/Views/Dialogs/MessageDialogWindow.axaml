<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Pact.App.Avalonia.Views.Dialogs.MessageDialogWindow"
        Icon="/Assets/AppIcon.ico"
        x:CompileBindings="False"
        Width="440"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppPaneBackgroundBrush}">
  <Grid Margin="20" RowDefinitions="Auto,Auto">
    <TextBlock x:Name="MessageText"
               MaxWidth="400"
               TextWrapping="Wrap"
               Foreground="{DynamicResource AppTextPrimaryBrush}" />
    <StackPanel Grid.Row="1"
                Margin="0,20,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8">
      <Button x:Name="YesButton" MinWidth="80" Content="Yes" Click="OnYesClicked" />
      <Button x:Name="NoButton" MinWidth="80" Content="No" Click="OnNoClicked" />
      <Button x:Name="CancelButton" MinWidth="80" Content="Cancel" Click="OnCancelClicked" />
    </StackPanel>
  </Grid>
</Window>
