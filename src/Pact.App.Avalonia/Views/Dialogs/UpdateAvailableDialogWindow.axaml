<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Pact.App.Avalonia.Views.Dialogs.UpdateAvailableDialogWindow"
        Icon="/Assets/AppIcon.ico"
        x:CompileBindings="False"
        Title="Pact update available"
        Width="520"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppPaneBackgroundBrush}">
  <Grid Margin="20" RowDefinitions="Auto,Auto">
    <TextBlock x:Name="ReleaseText"
               MaxWidth="480"
               TextWrapping="Wrap"
               Foreground="{DynamicResource AppTextPrimaryBrush}" />
    <StackPanel Grid.Row="1"
                Margin="0,20,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8">
      <Button x:Name="ReleaseNotesButton" MinWidth="130"
              Content="Open release notes" Click="OnReleaseNotesClicked" />
      <Button x:Name="LaterButton" MinWidth="80"
              Content="Later" Click="OnLaterClicked" />
      <Button x:Name="DownloadButton" MinWidth="90"
              Content="Download" Click="OnDownloadClicked" />
    </StackPanel>
  </Grid>
</Window>
