<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pact.Presentation.ViewModels"
             xmlns:views="using:Pact.App.Avalonia.Views"
             x:Class="Pact.App.Avalonia.Views.BrowserPaneView"
             x:DataType="vm:WebPageViewModel">
  <Grid Background="{StaticResource AppPaneBackgroundBrush}">
    <Grid x:Name="BrowserHost" Background="{StaticResource AppPaneBackgroundBrush}" />
    <Border x:Name="LoadingSurface"
            Background="{StaticResource AppPaneBackgroundBrush}"
            IsVisible="{Binding IsLoading}">
      <StackPanel Width="280" Spacing="12"
                  HorizontalAlignment="Center" VerticalAlignment="Center">
        <views:MissionControlLoader HorizontalAlignment="Center" />
        <TextBlock HorizontalAlignment="Center" Foreground="White" Text="Loading..." />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
