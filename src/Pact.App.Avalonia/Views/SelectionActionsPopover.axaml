<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Pact.Presentation.ViewModels;assembly=Pact.Presentation"
             x:Class="Pact.App.Avalonia.Views.SelectionActionsPopover"
             x:CompileBindings="False">
  <UserControl.DataTemplates>
    <TreeDataTemplate DataType="vm:SelectionActionTargetProjectViewModel" ItemsSource="{Binding Sessions}">
      <StackPanel Margin="0,0,0,4">
        <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
        <TextBlock FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" Text="{Binding RootPath}" />
        <Border IsVisible="{Binding HasNotesTarget}">
          <Button Margin="0,2,0,0" Padding="6,4" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Left" Content="🗒 Notes"
                  DataContext="{Binding NotesTarget}" Click="OnSelectionActionNotesClicked" />
        </Border>
      </StackPanel>
    </TreeDataTemplate>
    <DataTemplate DataType="vm:SessionViewModel">
      <Grid Margin="0,0,0,6" ColumnDefinitions="Auto,*">
        <Button Margin="0,0,8,0" Padding="8,2" Content="Send to" Click="OnSendSelectionClicked" />
        <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding TargetDisplayName}" />
      </Grid>
    </DataTemplate>
  </UserControl.DataTemplates>

  <Popup x:Name="SelectionPopup"
         IsLightDismissEnabled="True"
         OverlayDismissEventPassThrough="True"
         TakesFocusFromNativeControl="False"
         Placement="AnchorAndGravity"
         PlacementAnchor="TopLeft"
         PlacementGravity="BottomRight"
         PlacementConstraintAdjustment="None"
         Closed="OnPopupClosed">
    <Border Width="360"
            Background="{DynamicResource AppSurfaceBrush}"
            CornerRadius="8"
            BoxShadow="0 6 24 0 #50000000">
      <Grid>
        <Grid RowDefinitions="Auto,Auto,Auto">
          <ScrollViewer x:Name="ActionsScroll"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ActionsContent" Margin="12,12,12,8">
              <TextBlock FontSize="16" FontWeight="SemiBold" Text="Selection actions" />
              <ListBox x:Name="ActionsList"
                       Margin="0,8,0,0"
                       ItemsSource="{Binding SelectionActionChoices}"
                       SelectedItem="{Binding SelectedSelectionAction}">
                <ListBox.Styles>
                  <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="6,2" />
                    <Setter Property="IsEnabled" Value="{Binding IsSelectable}" />
                  </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Name}" IsEnabled="{Binding IsSelectable}" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>
          </ScrollViewer>

          <Border x:Name="PlacementDivider"
                  Grid.Row="1"
                  Height="1"
                  Margin="12,0"
                  Background="{DynamicResource AppBorderBrush}" />

          <ScrollViewer x:Name="TargetsScroll"
                        Grid.Row="2"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="TargetsContent" Margin="12,8,12,12">
              <TextBlock FontWeight="SemiBold" Text="Target sessions" />
              <TextBlock x:Name="CompactEmptyState"
                         Margin="0,8,0,0"
                         Foreground="{DynamicResource AppTextMutedBrush}"
                         Text="No suitable target sessions." />
              <TreeView x:Name="CompactTargetsTree" Margin="0,8,0,0">
                <TreeView.Styles>
                  <Style Selector="TreeViewItem">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded}" />
                  </Style>
                </TreeView.Styles>
              </TreeView>
              <TreeView x:Name="AllTargetsTree"
                        Margin="0,8,0,0"
                        IsVisible="False"
                        ItemsSource="{Binding SelectionActionTargetProjects}">
                <TreeView.Styles>
                  <Style Selector="TreeViewItem">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded}" />
                  </Style>
                </TreeView.Styles>
              </TreeView>
              <Button x:Name="MoreTargetsButton"
                      Margin="0,8,0,0"
                      Padding="8,4"
                      HorizontalAlignment="Left"
                      Content="More targets…"
                      Click="OnMoreTargetsClicked" />
            </StackPanel>
          </ScrollViewer>
        </Grid>
        <Border IsHitTestVisible="False"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="8" />
      </Grid>
    </Border>
  </Popup>
</UserControl>
